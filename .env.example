PORT=3000
ENV=development

DBHOST=localhost
DBPORT=5432
DBNAME=boson
DBUSERNAME=boson
DBPASSWORD=boson
DBSSLMODE=disable

# JWKS endpoint for verifying Supabase JWTs. Default points at the local
# Supabase CLI stack; in production set to
# https://<project>.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWKS_URL=http://localhost:54321/auth/v1/.well-known/jwks.json

# ----- Nick-claim POP3 worker -----
#
# The backend polls a mailbox we own for NickServ confirmation
# emails — PurelyMail in production, mailpit in local dev. POP3
# (not IMAP) because mailpit doesn't speak IMAP; PurelyMail
# supports both so one code path covers both ends. Worker no-ops
# when PURELYMAIL_POP3_HOST is empty, so this section is optional
# for non-mail dev work.
#
# Defaults below target the local mailpit container started by
# `make mailpit-up` / `make dev-up`. Mailpit auth-accepts anything,
# so user/password are placeholders. For production set these to
# the real PurelyMail credentials + flip PURELYMAIL_POP3_TLS back
# to true (and PURELYMAIL_POP3_PORT to 995).
PURELYMAIL_POP3_HOST=localhost
PURELYMAIL_POP3_PORT=1110
PURELYMAIL_POP3_USER=dev
PURELYMAIL_POP3_PASSWORD=dev
PURELYMAIL_POP3_TLS=false
NICK_CLAIM_EMAIL_DOMAIN=boson.chat
