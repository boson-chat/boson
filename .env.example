PORT=3000
ENV=development

DBHOST=localhost
DBPORT=5432
DBNAME=boson
DBUSERNAME=boson
DBPASSWORD=boson
DBSSLMODE=disable

# The boson auth service (github.com/boson-chat/auth), which issues the
# EdDSA access tokens the API accepts. Defaults match `make auth-up`
# (localhost:8080). Production: https://auth.boson.chat for both the issuer
# and the JWKS host.
AUTH_JWKS_URL=http://localhost:8080/.well-known/jwks.json
AUTH_ISSUER=http://localhost:8080
AUTH_AUDIENCE=boson

# ----- Nick claims (automatic NickServ registration) -----
#
# Off by default. Addresses are reg+<uid>-<token>@NICK_CLAIM_EMAIL_DOMAIN;
# the mailbox must be dedicated to this (the worker deletes mail that
# matches no claim). The backend polls a mailbox we own for NickServ
# confirmation emails: PurelyMail in production, mailpit in local dev
# (`make mailpit-up` / `make dev-up`; mailpit accepts any login).
# With BOSON_CONFIG set, the nick_claim: section of the stack config
# file wins over these (see README "Nick claims"). The password always
# comes from here. The older PURELYMAIL_POP3_* names still work as
# fallbacks for the NICK_CLAIM_POP3_* values, but don't enable it.
NICK_CLAIM_ENABLED=true
NICK_CLAIM_EMAIL_DOMAIN=boson.chat
NICK_CLAIM_POP3_HOST=localhost
NICK_CLAIM_POP3_PORT=1110
NICK_CLAIM_POP3_USER=dev
NICK_CLAIM_POP3_PASSWORD=dev
NICK_CLAIM_POP3_TLS=false

# ----- Internal listener -----
#
# GET /internal/config/status and the admin panel's
# /internal/nick-claims/* (X-Internal-Token: INTERNAL_TOKEN).
# Compose network only; never publish this port. INTERNAL_ADDR
# (host:port, or "off") wins over INTERNAL_PORT.
INTERNAL_PORT=3001
INTERNAL_TOKEN=

# ----- Cloudflare R2 (profile images) -----
#
# Signed-in users upload a profile image; the backend resizes it and
# stores it in an R2 bucket, served via the CDN at CLOUDFLARE_CDN_BASE_URL.
# Avatar uploads are disabled (the endpoint 503s) when
# CLOUDFLARE_R2_ACCESS_KEY is empty, so this section is optional for dev
# work that doesn't touch avatars. Real keys go in the deployment env /
# gitignored config — never commit them.
CLOUDFLARE_R2_ACCESS_KEY=
CLOUDFLARE_R2_SECRET_KEY=
CLOUDFLARE_R2_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
CLOUDFLARE_R2_BUCKET=boson
CLOUDFLARE_CDN_BASE_URL=https://cdn.boson.chat
