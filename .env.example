PORT=3000
ENV=development

DBHOST=localhost
DBPORT=5432
DBNAME=boson
DBUSERNAME=boson
DBPASSWORD=boson
DBSSLMODE=disable

# The boson auth service (github.com/boson-chat/auth), which issues the
# EdDSA access tokens the API accepts. Defaults match `make auth-up`
# (localhost:8080). Production: https://auth.boson.chat for both the issuer
# and the JWKS host.
AUTH_JWKS_URL=http://localhost:8080/.well-known/jwks.json
AUTH_ISSUER=http://localhost:8080
AUTH_AUDIENCE=boson

# ----- Nick-claim POP3 worker -----
#
# The backend polls a mailbox we own for NickServ confirmation
# emails — PurelyMail in production, mailpit in local dev. POP3
# (not IMAP) because mailpit doesn't speak IMAP; PurelyMail
# supports both so one code path covers both ends. Worker no-ops
# when PURELYMAIL_POP3_HOST is empty, so this section is optional
# for non-mail dev work.
#
# Defaults below target the local mailpit container started by
# `make mailpit-up` / `make dev-up`. Mailpit auth-accepts anything,
# so user/password are placeholders. For production set these to
# the real PurelyMail credentials + flip PURELYMAIL_POP3_TLS back
# to true (and PURELYMAIL_POP3_PORT to 995).
PURELYMAIL_POP3_HOST=localhost
PURELYMAIL_POP3_PORT=1110
PURELYMAIL_POP3_USER=dev
PURELYMAIL_POP3_PASSWORD=dev
PURELYMAIL_POP3_TLS=false
NICK_CLAIM_EMAIL_DOMAIN=boson.chat

# ----- Cloudflare R2 (profile images) -----
#
# Signed-in users upload a profile image; the backend resizes it and
# stores it in an R2 bucket, served via the CDN at CLOUDFLARE_CDN_BASE_URL.
# Avatar uploads are disabled (the endpoint 503s) when
# CLOUDFLARE_R2_ACCESS_KEY is empty, so this section is optional for dev
# work that doesn't touch avatars. Real keys go in the deployment env /
# gitignored config — never commit them.
CLOUDFLARE_R2_ACCESS_KEY=
CLOUDFLARE_R2_SECRET_KEY=
CLOUDFLARE_R2_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
CLOUDFLARE_R2_BUCKET=boson
CLOUDFLARE_CDN_BASE_URL=https://cdn.boson.chat
