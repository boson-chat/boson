VITE_SUPABASE_URL=http://localhost:54321
# New-style publishable key (sb_publishable_...). The legacy
# VITE_SUPABASE_ANON_KEY is still accepted as a fallback so `make client-env`
# (which reads ANON_KEY from the local Supabase CLI) keeps working unchanged.
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_BOSON_API_URL=http://localhost:3000

# Engine WebSocket bridge — populate via `make engine-env` after `make engine-serve`.
VITE_ENGINE_URL=
VITE_ENGINE_TOKEN=
