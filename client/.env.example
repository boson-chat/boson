# The boson auth service (accounts, sign-in). `make auth-up` runs one on
# :8080; production builds use https://auth.boson.chat (the default).
VITE_AUTH_URL=http://localhost:8080
VITE_BOSON_API_URL=http://localhost:3000
# The default network directory (browse + register). Production default:
# https://directory.boson.chat. A local one (the stack's directory profile),
# e.g. http://localhost:4100, works in dev builds.
# VITE_DIRECTORY_URL=

# Engine WebSocket bridge — populate via `make engine-env` after `make engine-serve`.
VITE_ENGINE_URL=
VITE_ENGINE_TOKEN=
