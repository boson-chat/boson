{
  "name": "boson-client",
  "version": "0.36.4",
  "private": true,
  "description": "Boson \u2014 desktop IRC client.",
  "homepage": "https://boson.chat",
  "author": {
    "name": "Boson",
    "email": "hi@boson.chat",
    "url": "https://boson.chat"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/boson-chat/boson.git",
    "directory": "client"
  },
  "main": "out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:renderer-only": "vite --config vite.renderer.config.ts",
    "test:e2e": "playwright test",
    "build:e2e-app": "node scripts/build-e2e-app.mjs",
    "test:e2e:app": "playwright test -c playwright.electron.config.ts",
    "build:e2e-wails": "node scripts/build-e2e-wails.mjs --with-renderer",
    "test:e2e:wails": "E2E_SHELL=wails playwright test -c playwright.electron.config.ts",
    "test:e2e:app:coverage": "E2E_COVERAGE=1 playwright test -c playwright.electron.config.ts",
    "build": "tsc --noEmit && electron-vite build",
    "build:installer": "npm run build && electron-builder --config electron-builder.yml --publish never",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@boson/shared": "*",
    "@noble/hashes": "^2.2.0",
    "@preact/signals": "^2.9.1",
    "@supabase/supabase-js": "^2.45.0",
    "@wailsio/runtime": "3.0.0-beta.30",
    "dompurify": "3.4.16",
    "electron-updater": "^6.8.3",
    "hash-wasm": "4.12.0",
    "highlight.js": "11.12.0",
    "katex": "0.18.9",
    "lucide-preact": "^1.18.0",
    "markdown-it": "14.3.2",
    "markdown-it-deflist": "4.0.0",
    "markdown-it-emoji": "3.1.0",
    "markdown-it-footnote": "4.0.0",
    "markdown-it-github-alerts": "1.0.1",
    "markdown-it-mark": "4.0.0",
    "mermaid": "12.0.0",
    "preact": "^10.22.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@preact/preset-vite": "^2.9.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/preact": "^3.2.4",
    "@testing-library/user-event": "^14.6.1",
    "@types/markdown-it": "14.2.0",
    "@types/markdown-it-emoji": "3.0.1",
    "@types/markdown-it-footnote": "3.0.4",
    "@types/node": "^20.14.0",
    "electron": "44.7.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "happy-dom": "^20.9.0",
    "jsdom": "30.1.1",
    "monocart-coverage-reports": "2.13.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.0",
    "vitest": "^4.1.7"
  }
}
