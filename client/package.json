{
  "name": "boson-client",
  "version": "0.14.0",
  "private": true,
  "description": "Boson — desktop IRC client.",
  "homepage": "https://boson.chat",
  "author": {
    "name": "Boson",
    "email": "hi@boson.chat",
    "url": "https://boson.chat"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/boson-chat/boson.git",
    "directory": "client"
  },
  "main": "out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:renderer-only": "vite --config vite.renderer.config.ts",
    "test:e2e": "playwright test",
    "build": "tsc --noEmit && electron-vite build",
    "build:installer": "npm run build && electron-builder --config electron-builder.yml --publish never",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@boson/shared": "*",
    "@noble/hashes": "^2.2.0",
    "@supabase/supabase-js": "^2.45.0",
    "electron-updater": "^6.8.3",
    "preact": "^10.22.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@preact/preset-vite": "^2.9.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/preact": "^3.2.4",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20.14.0",
    "electron": "^32.0.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "happy-dom": "^20.9.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.0",
    "vitest": "^4.1.7"
  }
}
