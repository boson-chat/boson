<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Hardened Runtime entitlements for the Developer ID–signed macOS build
  (electron-builder.yml → mac.entitlements / entitlementsInherit).

  Electron's V8 JIT needs to map writable+executable memory, which Hardened
  Runtime forbids unless allow-jit is granted. That is the only exception we
  need: no sandbox (Developer ID distribution, not the Mac App Store), no
  unsigned-memory / library-validation / DYLD-env relaxations. The Go engine
  sidecar is a plain hardened binary and needs none.
-->
<plist version="1.0">
<dict>
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
</dict>
</plist>
