bin
# The renderer build is copied in (client/scripts/build-e2e-wails.mjs);
# the placeholder keeps go:embed building on a fresh clone. (The root
# .gitignore ignores every dist/; re-include this one first, or the
# placeholder can't be tracked.)
!frontend/dist/
frontend/dist/*
!frontend/dist/.gitkeep
build/linux/appimage/build
build/windows/nsis/MicrosoftEdgeWebview2Setup.exe
