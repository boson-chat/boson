<?xml version="1.0" encoding="utf-8"?>
<!-- Cleartext stays off everywhere except this device's own loopback: the
     call's video frames and self-view come from the app's Go side over a
     loopback WebSocket (desktop/video_hub.go, ws://127.0.0.1:<port>, with a
     per-launch key), which the WebView otherwise refuses
     (net::ERR_CLEARTEXT_NOT_PERMITTED). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
